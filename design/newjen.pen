                                  "library": "lucide",
                                  "fill": "$fg-subtle"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "L2g7a",
                              "name": "Spring",
                              "width": "fill_container",
                              "height": 1
                            },
                            {
