              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Each card says how old its report is. A window past its reset drops its percentage.",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
