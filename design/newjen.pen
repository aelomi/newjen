              "type": "text",
              "id": "TFZsV",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• The pace mark is where even spending would be now. Ahead or behind by more than 5 points changes the line under the bar.",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
