      "layout": "vertical",
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "l2rS53",
          "name": "Head",
          "layout": "vertical",
          "gap": 6,
          "padding": [
            0,
            0,
            28,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "e1D7v",
              "name": "Text",
              "fill": "$fg",
              "content": "How updates behave",
              "fontFamily": "$font",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "HHMo4",
              "name": "Text",
              "fill": "$muted-fg",
              "content": "Newjen keeps itself current without ever taking the wheel.",
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "IJkyj",
          "name": "Rule Checks quietly",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "zMRwD",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "DeMUu",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Checks quietly",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "EOhdw",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "15 seconds after launch, then every hour. It never calls the GitHub API. It reads the releases feed on github.com and downloads from GitHub’s CDN, the way T3 Code does. A failed check says nothing.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "kVMvF",
          "name": "Rule Downloads itself, restarts on your click",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "vU27g",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "kzZAo",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Downloads itself, restarts on your click",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "sfHFl",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The update downloads in the background and its signature is checked. Only then does the pill appear. Restarting is always your click.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "xjkip",
          "name": "Rule Never mid-task",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "DQFcC",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "n3auei",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Never mid-task",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "u12Ki",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Restart goes through the quit gate. With agents working, you pick Restart now or Install when I quit.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "SRb2m",
          "name": "Rule Installs when you quit",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "G0S5fC",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "A5r7io",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Installs when you quit",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "poWM0",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A downloaded update replaces the app on the next quit, so ignoring the pill still updates you.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "welYI",
          "name": "Rule Notes once, then on request",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "i7xVZ",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "r97vL",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Notes once, then on request",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "MoOLx",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "After an update, a card at the foot of the sidebar offers What’s New. The notes ship inside the app, so the sheet works offline. It never opens by itself, and Help reopens it.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "vlnTI",
          "name": "Rule Every version since you last looked",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "I1FaO",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "K762Cf",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Skipped releases",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "F8Brd8",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Skip a few releases and the sheet shows the newest one, with a note that links to the ones you missed on GitHub.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "TBNsx",
          "name": "Rule Verified or nothing",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "FKPdY",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "p2trjj",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Verified or nothing",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "pLAiw",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Each zip carries an Ed25519 signature, checked against a key built into Newjen. A mismatch deletes the download.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "FzMQs",
          "name": "Rule Motion",
          "width": "fill_container",
          "stroke": "$hairline",
          "strokeWidth": {
            "bottom": 1
          },
          "gap": 24,
          "padding": [
            13,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "y57Xo",
              "name": "Label",
              "width": 320,
              "children": [
                {
                  "type": "text",
                  "id": "H8vJLK",
                  "name": "Text",
                  "fill": "$fg",
                  "content": "Motion",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "mVSlX",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The pill and the card fade in and rise 4 px over 200 ms with ease-out, once. The sheet scales up from 0.97 with a fade over 200 ms and closes in 150 ms. The progress bar fills linearly. Opened by a key, nothing moves. Reduce Motion keeps only the fades.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
  ],
