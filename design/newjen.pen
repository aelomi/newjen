              "type": "text",
              "id": "L26wC5",
              "name": "Text",
              "fill": "$muted-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Amber at 90% or when the pace runs out before the reset. Red at the limit.",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
