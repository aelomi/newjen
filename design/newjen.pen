                                  "library": "lucide",
                                  "fill": "$fg-subtle"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "L2g7a",
                              "name": "Spring",
                              "width": "fill_container",
                              "height": 1
                            },
                            {
                              "type": "frame",
                              "id": "EZlQZ",
                              "name": "Button",
                              "opacity": 0.35,
                              "width": 28,
                              "height": 28,
                              "fill": "$accent",
                              "cornerRadius": 14,
                              "justifyContent": "center",
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "icon",
                                  "id": "B67GR1",
                                  "name": "Icon",
                                  "width": 14,
                                  "height": 14,
